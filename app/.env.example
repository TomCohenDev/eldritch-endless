# n8n Environment Configuration
# Copy this to .env and configure as needed

# Options: 'test' | 'prod'
# test = https://n8n.yarden-zamir.com/webhook-test/...
# prod = https://n8n.yarden-zamir.com/webhook/...
VITE_N8N_ENV=prod

# Ollama (local Gemma 3) configuration for encounter/mythos generation
# Run `ollama pull gemma3:1b` to download the model
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma3:1b

# Google Gemini API key for AI generation (deprecated - now using Ollama)
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Anthropic (Claude) API key for plot generation
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs API key for text-to-speech narration
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here